# ========================================================
# PORTFOLIO ENVIRONMENT VARIABLES TEMPLATE
# ========================================================
# Copy this file to .env and fill in your values
# DO NOT commit your real .env file with credentials to git!

# Server port (default: 8080)
PORT=8080

# --------------------------------------------------------
# EMAIL NOTIFICATIONS (Gmail SMTP)
# --------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password under:
#    https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other" -> e.g. "Portfolio")
# 3. Enter your Gmail address and the 16-character App Password below:

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=sahilnikam107@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password

# Email recipient address where you want to receive inquiries:
PORTFOLIO_MAIL_TO=sahilnikam107@gmail.com
PORTFOLIO_MAIL_ENABLED=true
